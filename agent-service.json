{
  "name": "Glider Scout",
  "version": "1.2.0",
  "description": "Verified, spam-filtered GitHub crypto/software bounty feed with per-item credibility verdicts. Free teaser; paid full feed via x402 (USDC on Base).",
  "category": "bounties",
  "author": { "name": "Glider", "wallet": "0x944664B9d45fEf8C9BDBb084Ce59E6f6eE724861" },
  "source": "https://github.com/Dinerbone3912/glider-scout",
  "mcp": { "command": "npx", "args": ["glider-scout-mcp"], "tools": ["list_bounties", "score_bounty", "feed_health"] },
  "endpoints": [
    {
      "method": "GET",
      "path": "/bounties?limit={n}",
      "teaser": "limit<=3 → 200, free",
      "paid": "limit>3 → x402, 0.01 USDC per full pull",
      "pricing": {
        "scheme": "exact",
        "network": "base",
        "amount": "0.01",
        "currency": "USDC",
        "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
        "payTo": "0x944664B9d45fEf8C9BDBb084Ce59E6f6eE724861"
      }
    },
    { "method": "GET", "path": "/score?url={issueUrl}", "description": "Verdict for one listing: LIKELY_CREDIBLE|UNVERIFIED|REJECT|FRAUD" },
    { "method": "GET", "path": "/health", "description": "Liveness + price/payee summary" }
  ],
  "fraud_classifier": { "module": "fraud.mjs", "signals": 9, "verdicts": ["LIKELY_CREDIBLE","UNVERIFIED","REJECT","FRAUD"] },
  "payment_note": "Server verifies confirmed tx AND a USDC Transfer >= 0.01 to payTo; fail-closed otherwise."
}
